# state must be on the execution host's local disk, never SMB/NFS.
WPUPLOADER_STATE_DIR=/data
WPUPLOADER_TRANSFER_DIR=
# Optional compose.transfer.yaml host directory; create ready/ and receipts/ first.
DRAFT_TRANSFER_HOST=
WORDPRESS_ENABLED=false
WORDPRESS_BASE_URL=https://wordpress.example
WORDPRESS_POST_TYPE=news_weave
WORDPRESS_REST_BASE=news-weave
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_CATEGORY_MAP={}
WORDPRESS_TAG_MAP={}
REVIEW_REQUIRED=false
