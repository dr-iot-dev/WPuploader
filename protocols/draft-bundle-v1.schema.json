{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DraftBundleV1 package.json",
  "type": "object",
  "required": [
    "schema_version",
    "producer_id",
    "article_id",
    "draft_id",
    "package_id",
    "revision",
    "artifact_revision",
    "manifest_hash",
    "files",
    "title",
    "excerpt",
    "category_keys",
    "source_urls",
    "source_set_hash",
    "source_normalization_version",
    "eligibility",
    "featured_image",
    "image_skip_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "producer_id": {
      "type": "string",
      "format": "uuid"
    },
    "article_id": {
      "type": "string",
      "format": "uuid"
    },
    "draft_id": {
      "type": "string",
      "format": "uuid"
    },
    "package_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_revision": {
      "type": "integer",
      "minimum": 1
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "size",
          "sha256"
        ],
        "properties": {
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "excerpt": {
      "type": "string",
      "maxLength": 2000
    },
    "category_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tag_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "source_set_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_normalization_version": {
      "const": "source-set-v1"
    },
    "eligibility": {
      "type": "object",
      "required": [
        "verification",
        "mode",
        "review_required",
        "html_hash",
        "markdown_hash"
      ],
      "properties": {
        "verification": {
          "const": "pass"
        },
        "mode": {
          "const": "production"
        },
        "review_required": {
          "type": "boolean"
        },
        "review": {
          "enum": [
            "approve",
            null
          ]
        },
        "html_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "markdown_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "featured_image": {
      "type": [
        "object",
        "null"
      ]
    },
    "image_skip_reason": {
      "enum": [
        "disabled",
        "manual_skip",
        null
      ]
    }
  }
}
